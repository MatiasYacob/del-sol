{
  "name": "@del-sol/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc && concurrently -k \"tsc --watch\" \"node --watch dist/main.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "create-admin": "node scripts/create-admin.mjs",
    "test:auth": "npm run build && node --test test/auth.integration.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "argon2": "0.45.1",
    "cookie": "0.7.2",
    "mysql2": "3.24.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/cookie": "0.6.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "typescript": "5.9.3"
  }
}
